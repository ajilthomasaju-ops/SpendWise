# Copy this file to .env and replace the example values.
PORT=3000
NODE_ENV=development

# Use a long, random value. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# The account registered with this email receives owner-admin access.
ADMIN_EMAIL=admin@example.com

# Optional in development. Production requires MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# Set true only when you want the local demo account and sample transactions.
# Demo seeding is disabled automatically in production.
SEED_DEMO_DATA=false
